# Servidor local (maquina do chefe)
PR_VALIDATOR_HOST=127.0.0.1
PR_VALIDATOR_PORT=5000
PR_VALIDATOR_DB=data/pr_validator.sqlite3
# Mesmo valor do secret PR_VALIDATOR_WEBHOOK_SECRET cadastrado no GitHub (gere um valor longo e aleatorio)
PR_VALIDATOR_WEBHOOK_SECRET=

# IA local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
PR_MODEL_NAME=llama3.1:8b
PR_NUM_CTX=32768
PR_OUTPUT_RESERVE_TOKENS=2048
PR_OLLAMA_TIMEOUT=900

# Coleta
PR_GH_TIMEOUT=120
PR_DOCS_PATHS=docs/,README.md
PR_DOC_EXTENSIONS=.md,.mdx,.rst,.txt
PR_MAX_DOC_FILE_BYTES=200000
# Padroes extras (glob, separados por virgula) para remover do diff
PR_DIFF_IGNORE_EXTRA=
